<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/background">


    <TextView
        android:id="@+id/comparisonTitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Which movie do you prefer?"

        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="26sp"

        android:layout_marginTop="60dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- MOVIE A -->

    <TextView
        android:id="@+id/movieAName"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="Movie A"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"

        android:gravity="center"

        android:layout_marginTop="60dp"

        app:layout_constraintTop_toBottomOf="@id/comparisonTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/movieAButton"

        android:layout_width="280dp"
        android:layout_height="120dp"

        android:text="Movie A"

        android:textSize="20sp"
        android:textColor="#FFFFFF"

        android:background="@drawable/ranking_selector"

        android:layout_marginTop="15dp"

        app:layout_constraintTop_toBottomOf="@id/movieAName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- VS -->

    <TextView
        android:id="@+id/vsText"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="VS"

        android:textColor="#B9A9E0"
        android:textSize="24sp"
        android:textStyle="bold"

        android:layout_marginTop="25dp"

        app:layout_constraintTop_toBottomOf="@id/movieAButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- MOVIE B -->

    <TextView
        android:id="@+id/movieBName"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="Movie B"

        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"

        android:gravity="center"

        android:layout_marginTop="25dp"

        app:layout_constraintTop_toBottomOf="@id/vsText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/movieBButton"

        android:layout_width="280dp"
        android:layout_height="120dp"

        android:text="Movie B"

        android:textSize="20sp"
        android:textColor="#FFFFFF"

        android:background="@drawable/ranking_selector"

        android:layout_marginTop="15dp"

        app:layout_constraintTop_toBottomOf="@id/movieBName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <Button
        android:id="@+id/finishComparisonButton"

        android:layout_width="180dp"
        android:layout_height="60dp"

        android:text="Finish"

        android:visibility="gone"

        android:layout_marginTop="35dp"

        app:layout_constraintTop_toBottomOf="@id/movieBButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>