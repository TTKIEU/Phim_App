<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="30dp"
    android:background="#16172F">

    <ImageButton
        android:id="@+id/searchBackButton"

        android:layout_width="48dp"
        android:layout_height="48dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"

        android:background="@android:color/transparent"

        android:src="@drawable/ic_back"

        android:contentDescription="Back"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/movieSearchInput"

        android:layout_width="0dp"
        android:layout_height="56dp"

        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"

        android:hint="Search movies..."

        android:singleLine="true"

        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"

        app:layout_constraintStart_toEndOf="@id/searchBackButton"
        app:layout_constraintEnd_toStartOf="@id/movieSearchButton"
        app:layout_constraintTop_toTopOf="@id/searchBackButton"
        app:layout_constraintBottom_toBottomOf="@id/searchBackButton" />

    <Button
        android:id="@+id/movieSearchButton"

        android:layout_width="90dp"
        android:layout_height="56dp"

        android:layout_marginEnd="16dp"

        android:text="Search"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/movieSearchInput" />

    <ProgressBar
        android:id="@+id/searchProgress"

        android:layout_width="40dp"
        android:layout_height="40dp"

        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/movieSearchInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchRecyclerView"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_margin="16dp"

        app:layout_constraintTop_toBottomOf="@id/searchProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>