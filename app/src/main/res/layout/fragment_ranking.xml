<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <!-- Main ranking card -->
    <ImageButton
        android:id="@+id/backToProfile"
        android:layout_width="45dp"
        android:layout_height="45dp"

        android:src="@drawable/ic_back"
        android:background="@android:color/transparent"
        android:contentDescription="Back"

        android:elevation="10dp"

        android:layout_marginStart="20dp"
        android:layout_marginTop="55dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:id="@+id/rankingCard"
        android:layout_width="460dp"
        android:layout_height="wrap_content"

        android:background="@drawable/ranking_container"
        android:gravity="center_horizontal"

        android:orientation="vertical"

        android:padding="30dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- Genre selector -->

        <LinearLayout
            android:layout_width="230dp"
            android:layout_height="50dp"

            android:background="@drawable/ranking_selector"
            android:gravity="center"

            android:orientation="horizontal">


            <ImageButton
                android:id="@+id/genreIcon"
                android:layout_width="45dp"
                android:layout_height="45dp"

                android:background="@android:color/transparent"
                android:contentDescription="Genre"
                android:src="@drawable/background" />

            <Spinner
                android:id="@+id/genreSpinner"
                android:layout_width="150dp"
                android:layout_height="wrap_content"


                android:entries="@array/movie_genres" />

        </LinearLayout>


        <!-- Movie poster -->

        <ImageView
            android:id="@+id/moviePoster"
            android:layout_width="290dp"
            android:layout_height="190dp"

            android:layout_marginTop="30dp"

            android:contentDescription="Movie poster"

            android:scaleType="centerCrop"
            android:src="@drawable/background" />


        <!-- Movie name -->

        <EditText
            android:id="@+id/movieNameInput"
            android:layout_width="290dp"
            android:layout_height="55dp"

            android:layout_marginTop="20dp"

            android:background="@drawable/ranking_selector"
            android:gravity="center"

            android:hint="Movie name"
            android:textColor="#FFFFFF"

            android:textColorHint="#CCCCCC" />


        <!-- Rating buttons -->

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="100dp"

            android:layout_marginTop="20dp"

            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/greatButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:text="Great"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#CC72D58A"
                app:cornerRadius="45dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/okButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="Ok"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#D9CF65"
                app:cornerRadius="45dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/badButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:text="Bad"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#C36D6D"
                app:cornerRadius="45dp" />

        </LinearLayout>


        <!-- Notes -->

        <EditText
            android:id="@+id/notesInput"
            android:layout_width="320dp"
            android:layout_height="55dp"

            android:layout_marginTop="15dp"

            android:background="@drawable/ranking_selector"
            android:gravity="center"

            android:hint="@string/notes"
            android:textColor="#FFFFFF"

            android:textColorHint="#B9A9E0" />


        <!-- Submit -->

        <Button
            android:id="@+id/submitRankingButton"
            android:layout_width="150dp"
            android:layout_height="55dp"

            android:layout_marginTop="25dp"

            android:background="@drawable/ranking_selector"
            android:text="@string/submit"
            android:textColor="#B9A9E0"

            android:textSize="18sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>