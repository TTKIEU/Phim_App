<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/background">

    <TextView
        android:id="@+id/rankingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Rank a Movie"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="60dp" />

    <EditText
        android:id="@+id/movieNameInput"
        android:layout_width="0dp"
        android:layout_height="60dp"

        android:hint="Movie name"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"

        android:paddingStart="20dp"

        app:layout_constraintTop_toBottomOf="@id/rankingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="50dp" />

    <EditText
        android:id="@+id/ratingInput"
        android:layout_width="0dp"
        android:layout_height="60dp"

        android:hint="Rating (0-10)"
        android:inputType="numberDecimal"

        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"

        android:paddingStart="20dp"

        app:layout_constraintTop_toBottomOf="@id/movieNameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/submitRankingButton"
        android:layout_width="200dp"
        android:layout_height="60dp"

        android:text="Rank Movie"

        app:layout_constraintTop_toBottomOf="@id/ratingInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="40dp" />

</androidx.constraintlayout.widget.ConstraintLayout>