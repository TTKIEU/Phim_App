<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="16dp"

    app:cardBackgroundColor="#66594C95"

    app:cardCornerRadius="28dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:padding="18dp">

        <ImageView
            android:id="@+id/feedPoster"

            android:layout_width="70dp"
            android:layout_height="105dp"

            android:scaleType="centerCrop"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/feedActivityText"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"

            android:textColor="#FFFFFF"

            android:textSize="16sp"
            android:textStyle="bold"

            app:layout_constraintStart_toEndOf="@id/feedPoster"
            app:layout_constraintEnd_toStartOf="@id/feedRatingText"
            app:layout_constraintTop_toTopOf="@id/feedPoster" />

        <TextView
            android:id="@+id/feedRatingText"

            android:layout_width="52dp"
            android:layout_height="52dp"

            android:gravity="center"

            android:textColor="#FFFFFF"
            android:textStyle="bold"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/feedNotesText"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"

            android:textColor="#DDFFFFFF"

            android:textSize="14sp"

            app:layout_constraintStart_toEndOf="@id/feedPoster"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/feedActivityText" />

        <TextView
            android:id="@+id/feedTimeText"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"

            android:textColor="#AAAAAA"

            android:textSize="12sp"

            app:layout_constraintStart_toEndOf="@id/feedPoster"
            app:layout_constraintTop_toBottomOf="@id/feedNotesText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>