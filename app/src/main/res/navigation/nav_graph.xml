<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/nav_graph"

    app:startDestination="@id/loginFragment">

<!--    login-->

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.phim.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"

            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

    </fragment>



    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.phim.RegisterFragment"
        android:label="Register">

        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"

            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>


    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.phim.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_homeFragment_to_friendsFragment"
            app:destination="@id/friendsFragment" />

    </fragment>


    <fragment
        android:id="@+id/profileFragment"

        android:name="com.example.phim.ProfileFragment"

        android:label="Profile">

        <action
            android:id="@+id/action_profileFragment_to_movieSearchFragment"

            app:destination="@id/movieSearchFragment" />
        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_profileFragment_to_loginFragment"

            app:destination="@id/loginFragment"

            app:popUpTo="@id/homeFragment"

            app:popUpToInclusive="true" />

    </fragment>


    <fragment
        android:id="@+id/movieSearchFragment"

        android:name="com.example.phim.MovieSearchFragment"

        android:label="Search">

        <action
            android:id="@+id/action_movieSearchFragment_to_rankingFragment"

            app:destination="@id/rankingFragment" />

    </fragment>


    <fragment
        android:id="@+id/rankingFragment"

        android:name="com.example.phim.RankingFragment"

        android:label="Rank Movie">

        <action
            android:id="@+id/action_rankingFragment_to_comparisonFragment"

            app:destination="@id/comparisonFragment" />

        <action
            android:id="@+id/action_rankingFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false"
            app:launchSingleTop="true" />

    </fragment>


    <fragment
        android:id="@+id/comparisonFragment"

        android:name="com.example.phim.ComparisonFragment"

        android:label="Compare">

        <action
            android:id="@+id/action_comparisonFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false"
            app:launchSingleTop="true" />

    </fragment>


    <fragment
        android:id="@+id/friendsFragment"

        android:name="com.example.phim.FriendsFragment"

        android:label="Friends" />

</navigation>